opt_file=0;
arg_file="";

opt_n=0;
arg_n="";

opt_l=0;
opt_t=0;
opt_p=0;
opt_i=0;
opt_fake_su=0;

opt_script_provided=0;
arg_script=();

make_command_fail_ids=();

trailing_args=();
while (($#)); do
	arg=$1;
	shift;
	case "$arg" in
		(-h|--help)
			help;
			exit 0;
			;;
		(---)
			opt_script_provided=1;
			arg_script=("$@");
			set --;
			break;
			;;
		(--)
			break;
			;;
		(-f|--file)
			opt_file=1;
			arg_file=$1;
			shift;
			;;
		(-n)
			opt_n=1;
			arg_n=$1;
			[[ "$arg_n" =~ ^[0-9]+$ ]] || {
				1>&2 echo "The value provided to -n must be numeric and positive.";
				exit 1;
			};
			shift;
		    ;;
		(-l)
			opt_l=1;
			;;
		(-t)
			opt_t=1;
			;;
		(-p)
			opt_p=1;
			;;
		(-i)
			opt_i=1;
			;;
		(--fake-su)
			opt_fake_su=1;
			;;
		(--make-command-fail)
			make_command_fail_ids+=("$1");
			shift;
			;;
		(*)
			trailing_args+=("$arg");
			;;
	esac
done;
set -- "${trailing_args[@]}" "$@";
unset trailing_args;
unset arg;


testable() {
	local command_id=$1;
	shift;
    local id;
	for id in "${make_command_fail_ids[@]}"; do
		if [ "$id" == "$command_id" ]; then
			return 1;
		fi;
	done;
	"$@";
}
testable id_asdgierguirh true;


dump_bin() {
	echo %binary_object;
	# MAYBE TODO: i probably have to send useless chars and read them
	# back because base64 doesn't seem to handle an actual empty
	# stream.
	base64 -w 10000;
	echo %end;
}
read_line() {
	local IFS="";
	local line;
	read -r line;
	printf %s "$line";
}
# read_line_ln() {
# 	printf '%s\n' "$(read_line)";
# }
read_bin() {
	local first_line;
	first_line=$(read_line);
	[ "$first_line" == %binary_object ] || return 1;
	{
		while IFS="" read -r line || [ -n "$line" ]; do
			[ "$line" == %end ] && break;
			printf %s "$line";
		done;
	} | base64 --decode;
}

read_bin_pipe_dump_bin() {
	local first_line;
	first_line=$(read_line);
	[ "$first_line" == %binary_object ] || return 1;
	echo "$first_line";
	local line;
	while IFS="" read -r line || [ -n "$line" ]; do
		echo . 1>&2;
		[ "$line" == %end ] && {
			echo %end;
			break;
		};
		printf %s\\n "$line";
	done;
}


mktemp_fifo() {
	local temp_file;
	temp_file=$(mktemp) || {
		return 1;
	};
	rm -f -- "$temp_file" || {
		return 1;
	};
	mkfifo -- "$temp_file" || {
		return 1;
	};
	printf '%s\n' "$temp_file";
}

