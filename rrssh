				(@@coverage)
					echocom @@coverage;
					read_bin_pipe_dump_bin 1>&3;
					;;
				(*)
					panic "Unknown object in kernel dump: '$object_type'.";
					;;
			esac;
		done;
	} < "$KERNEL_PATH";

	# this ensures that we dont run if the connection was broken
	# during duplication.
	if ! ((eof_encountered)); then
		panic "The end of file token was not in the kernel dump.";
	fi;
}




