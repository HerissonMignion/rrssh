sanitize_path() {
	local ret=$1;
	# MAYBE TODO: write this "correctly" with temp variables.
	local i;
	for ((i = 0; i < 20; i++)); do
		ret=${ret//"//"/"/"};
	done;
	ret=${ret%/};
	ret=${ret%/};
	ret=${ret%/};
	[ -z "$ret" ] && ret=/;
	printf %s\\n "$ret";
}

# the parent directory must exist because we just use pwd to do the
# job.  i wrote this function because i've seen systems that dont have
# this command.	
bash_realpath() {
	local input_path=$(sanitize_path "$1");
	if [ "$input_path" == / ]; then
		echo /;
		return 0;
	fi;
	local basename="${input_path##*/}";
	local dirname="${input_path%/*}";
	[ "$dirname" == "$input_path" ] && dirname=.;
	(
		cd -- "$dirname" || exit 1;
		printf %s\\n "$(pwd)/$basename";
	);
}



validate_drop_item_name() {
	local name=$1;
	case "$name" in
		# no technical reason to disallow square brackets but disallow
		# anyway.
		(""|.|..|"["|"]")
			return 1;
			;;
	esac;

	# slashes are disallowed.  we dont handle relatives paths for
	# destinations.
	local subst=${name//"/"/_};
	[ "$name" == "$subst" ] || return 1;

	return 0;
}

handle_incoming_files_and_dirs() {
	local header=$1; # the @@@@ line
	local is_local=$2; # 1 = file system. 0 = stdin.
	local dest_dropdir=$3;
	local dest_name=$4;
	local local_source_path=$5; # only provided for local source

	validate_drop_item_name "$dest_name" || {
