						;;
					(@@child_dropdir)
						read_bin_pipe_dump_bin &> /dev/null;
						;;
					(@@coverage)
						if [ -n "$RRSSH_COVERAGE_FILE" ]; then
							read_bin >> "$RRSSH_COVERAGE_FILE";
						else
							read_bin_pipe_dump_bin &> /dev/null;
						fi;
						;;
					(*)
						1>&2 echo "Unknown object in kernel output, will trigger panic: $line";
						must_panic=1;
						;;
				esac;
			done;
			if ((trap_ran)); then
				trap_ran=0;
				restart_loop=1;
			fi;
		done;
	) 0< "$rootkernel_stdout" 7<&-;
	exec 6>&- 7<&-;
	rm -f "$temp_kernel_path";
	rm -f "$rootkernel_stdin";
	rm -f "$rootkernel_stdout";

	local exitcode_received=0;
	local exitcode=0;
	local panic_received=0;
	local bliss_received=0;
	while IFS="" read -r line || [ -n "$line" ]; do
		case "$line" in
			(@@exitcode)
				exitcode_received=1;
				exitcode=$(read_bin);
