	) > "$temp_com_file";

	# the landing process has its own "stream" of error messages other
	# than "stdout" "stderr" so that we catch and print these messages
	# only if rrssh was not provided the option to not panic on failed
	# ssh/su.
	local landing_msgs=(); # all errors.  the landing does not print any happy messages.
	local landing_failed=0;

	local bliss_received=0;
	local ignore_missing_bliss=0;
	local must_panic=0;
	local execution_total_args_shift=0;
	local scope_exitcode_received=0;
	local scope_exitcode=0;
	local fork_command_rc_received=0;
	local fork_command_rc=0;
	local landing_start_received=0;
	local kernel_start_received=0;
	while IFS="" read -r line || [ -n "$line" ]; do
		case "$line" in
			(@panic)
				must_panic=1;
				break;
				;;
			(@bliss)
				bliss_received=1;
				;;
			(@@total_toplevel_shift)
				execution_total_args_shift=$(read_bin);
				;;
			(@@scope_exitcode)
				scope_exitcode_received=1;
				scope_exitcode=$(read_bin);
				;;
			(@@fork_command_rc)
				fork_command_rc_received=1;
				fork_command_rc=$(read_bin);
				;;
			(@landing_start)
				landing_start_received=1;
				;;
			(@kernel_start)
				kernel_start_received=1;
				;;
			(@@print_landing_err)
				landing_msgs+=("$(read_bin)");
				;;
			(*)
				error "Unknown message received from sub kernel result parsing code: '$line'.";
				must_panic=1;
				break;
				;;
		esac;
	done < "$temp_com_file";
	rm -f "$temp_com_file";

	if ((must_panic)); then
		panic "Triggering a panic.";
	fi;

	if ((fork_command_rc_received)) && ! ((fork_command_rc == 0)); then

		# whether we received @landing_start is the difference between
		# a failing ssh/su VS the landing script that exited non-0
		# voluntarily.

		landing_failed=1;

		if ((landing_start_received)); then
			if ((kernel_start_received)); then
				landing_msgs+=(
					"The ssh or su command succeeded and the sub-kernel started, but something happened."
				);
			else
				landing_msgs+=(
					"The ssh or su command succeeded, but the sub-kernel could not be started during duplication."
				);
			fi;
		else
			landing_msgs+=(
				"The ssh or su command seems to fail."
				"Is an ssh key missing?"
				"Is ssh, su, or sudo prompting for a password?"
				"Is the destination resolving and reachable?"
				"Is there any spelling misatke?"
			);
		fi;
	elif ! ((landing_start_received)); then
		landing_failed=1;
		landing_msgs+=(
			"The ssh or su command seems to fail."
			"Is an ssh key missing?"
			"Is ssh, su, or sudo prompting for a password?"
			"Is the destination resolving and reachable?"
			"Is there any spelling misatke?"
		);
	elif ! ((kernel_start_received)); then
		landing_failed=1;
		landing_msgs+=(
			"The ssh or su command succeeded, but the kernel failed to start."
		);
	fi;

	if ((landing_failed)); then
		if ! ((opt_i)); then
			panic "${landing_msgs[@]}";
		else

			# MAYBE TODO: maybe we should still panic if we are a
			# simple scope and not a host or su command.

			ignore_missing_bliss=1;
			# instead of panicking, we behave like a scope that exited non-0.
			scope_exitcode_received=1;
			scope_exitcode=1;
		fi;
	fi;

	[ "$execution_total_args_shift" == "$total_scope_args_shift" ] || {

		# if the sub scope did not end because of a non-0 command, it
		# is normal that execution did not consume as many arguments
		# as pre-execution analysis.

		if ((scope_exitcode == 0)); then
			panic "The amount of token consumed during scope analysis is not equal as when executed.  scan: $total_scope_args_shift. execution: $execution_total_args_shift. bliss: $bliss_received. ";
		fi;
	};
	shift_toplevel_args "$total_scope_args_shift";

	if ! ((bliss_received)) && ! ((ignore_missing_bliss)); then
		panic "Sub kernel at remote host did not end blissfully.";
	fi;

	if ((scope_exitcode_received)); then
		return "$scope_exitcode";
	fi;

}

