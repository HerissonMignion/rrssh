pipestatus_save() {
	PIPESTATUS_BACKUP=("${PIPESTATUS[@]}");
}
pipestatus_debug() {
	# shellcheck disable=SC2317
	debug "PIPESTATUS_BACKUP: ${PIPESTATUS_BACKUP[*]}";
}
# prints the index of the first non-0 exit code, and return with that
# code.  if given an index, instead print the exitcode.
pipestatus_check() {
	local index=$1;
	if [ -n "$index" ]; then
		if ((index <= ${#PIPESTATUS_BACKUP[@]})); then
			echo "${PIPESTATUS_BACKUP[index]}";
			return "${PIPESTATUS_BACKUP[index]}";
		else
			error "PROBLEM WITH INDEX GIVEN TO pipestatus_check";
			exit 1;
		fi;
	fi;
	local i;
	for ((i = 0; i < ${#PIPESTATUS_BACKUP[@]}; i++)); do
		if ((PIPESTATUS_BACKUP[i] > 0)); then
			echo "$i";
			return "${PIPESTATUS_BACKUP[i]}";
		fi;
	done;
	return 0;
}
pipestatus_test() {
	pipestatus_check "$@" &> /dev/null;
