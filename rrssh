# in a huge pipe line of many commands that communicate with our
# protocol by sending messages to their fd 1 (next command in pipe
# line) or fd 3, we must avoid the situation where multiple sections
# of the pipe line tries to write messages to fd 3 (our parent
# kernel).  multiple writes are not atomic, therefore the protocol
# breaks because it breaks the flow of @header followed by its
# arguments if an other command begins to write a message while the
# previous message is not completed.

# the easiest way to enforce protection of the protocol is that only
# one command in a pipe line is "priviledged" to write to fd 3, the
# others must write to their fd 1 or in temp files that can be managed
# at the appropriate time.  i dont want to "automate" the handling of
# fd 3 with lock files, it's probably asking for problems or risking a
# deadlock.

# THEREFORE generic_message_handler will be that priviledged function,
# so it goes at the end of a pipe line.

generic_message_handler() {
	# we cannot handle panic because we will always be inside a
	# subshell.  therefore we must forward the panic, which is also
	# our own panic mecanism for unknown message type.

	# the number of @ in general is the number of argments plus one,
	# so that a function like this one can yield back messages that it
	# doesn't support.

	local line;
	local subline;
	while IFS="" read -r line || [ -n "$line" ]; do
		# debug "GENERIC $rrssh_fork_depth: $line";
		case "$line" in
			(@@print_stdout)
				echocom @@print_stdout;
				read_bin_pipe_dump_bin 1>&3;
				;;
			(@@print_stderr)
				echocom @@print_stderr;
				read_bin_pipe_dump_bin 1>&3;
				;;
			(@panic)
				echo @panic;
				;;
			(@bliss)
				echo @bliss;
				;;
			(@@exitcode)
				echocom @@exitcode;
				read_bin_pipe_dump_bin 1>&3;
				;;
			(@@coverage)
				echocom @@coverage;
				read_bin_pipe_dump_bin 1>&3;
				;;
			(@epoll_panic)
				# this message should only be received from a
				# subkernel, therefore we have fd 6.
				if ((opt_stdin)); then
					echocom @epoll_panic;
					while IFS="" read -r subline || [ -n "$subline" ]; do
						case "$subline" in
							(@panic)
								echo @panic 1>&6;
								break;
								;;
							(@continue)
								echo @continue 1>&6;
								break;
								;;
							(*)
								error "Unknown message '$subline' received from parent. Panic.";
								echo @panic 1>&6;
								break;
								;;
						esac;
						break;
					done 0<&5;
				else
					echo @continue 1>&6;
				fi;
				;;
			(@@@@file|@@@@dir)
				if ! ((is_root_kernel)); then
					echocom "$line";
					read_bin_pipe_dump_bin 1>&3;
					read_bin_pipe_dump_bin 1>&3;
					read_bin_pipe_dump_bin 1>&3;
				else
					read_bin_pipe_dump_bin > /dev/null;
					read_bin_pipe_dump_bin > /dev/null;
					read_bin_pipe_dump_bin > /dev/null;
				fi;
				;;
			(@@child_dropdir)
				echo @@child_dropdir;
				read_bin_pipe_dump_bin;
				;;
			(@@@@*)
				echo "$line";
				read_bin_pipe_dump_bin;
				read_bin_pipe_dump_bin;
				read_bin_pipe_dump_bin;
				;;
			(@@@*)
				echo "$line";
				read_bin_pipe_dump_bin;
				read_bin_pipe_dump_bin;
				;;
			(@@*)
				echo "$line";
				read_bin_pipe_dump_bin;
				;;
			(@*)
				echo "$line";
				;;
			(*)
				error "generic_message_handler: Unknown message '$line'.  Panic.";
				echo @panic;
				;;
		esac;
	done;
}



# The "contract" with the command commands is as follow: They are
# responsible for shifting and consuming the toplevel_args because
# only they know how much arguments they consume.  They must respect
# the value of op_mode.  They can panic.  They must use their
# exit-code to indicate whether they must be considered successful or
# in error in regards to the operators and or not try.  They must only
# run (but always consume their arguments) if the main loop sets the
# variable indicating to do so.

# the main execution loop sets this when commands must read their
# arguments but skip their execution.  for example when running a
# "command chain".

skip_current_command_execution_flag=0;

current_command_must_run_p() {
	[ "$op_mode" == scan ] && return 1;
	((skip_current_command_execution_flag)) && return 1;
	return 0;
}

command_command() {
	local arg0=$(peek_toplevel_args);
	shift_toplevel_args;

	# command needs either a string for system() or [ ], so one argument obligatory.
	any_toplevel_args_remaining || {
		panic "The command 'command' must be provided with an argument.";
	};

	local arg1=$(peek_toplevel_args);
	local string_command="";
	local is_string=1;
	local argv=();
	local end_token="";

	if [ "$arg0" == --- ]; then
		is_string=0;
		end_token="---";
	else
		shift_toplevel_args;
		if [ "$arg1" == "[" ]; then
			is_string=0;
			end_token="]";
		else
			string_command=$arg1;
		fi;
	fi;
	
	local end_token_reached=0;
	if ! ((is_string)); then
		while any_toplevel_args_remaining; do
			if [ "$(peek_toplevel_args)" == "$end_token" ]; then
				end_token_reached=1;
				shift_toplevel_args;
				break;
			fi;
			argv+=("$(peek_toplevel_args)");
			shift_toplevel_args;
		done;

		((end_token_reached)) || {
			panic "The command 'command' must end with the corresponding ending token: '$end_token'.";
		};
	fi;

	current_command_must_run_p || return 0;

	local rc=0;
	if ((is_string)); then
		bash -c "$string_command" 0< /dev/null 3>&- |& send_to_stdout;
		rc=${PIPESTATUS[0]};
	else
		(
			"${argv[@]}";
			exit "$?";
		) 0< /dev/null 3>&- |& send_to_stdout;
		rc=${PIPESTATUS[0]};
	fi;
	wait;

	return "$rc";
}


