opt_file=0;
arg_file="";

opt_n=0;
arg_n="";

opt_l=0;
opt_t=0;
opt_p=0;
opt_i=0;
opt_fake_su=0;

opt_script_provided=0;
arg_script=();

make_command_fail_ids=();

trailing_args=();
while (($#)); do
	arg=$1;
	shift;
	case "$arg" in
		(-h|--help)
			help;
			exit 0;
			;;
		(---)
			opt_script_provided=1;
			arg_script=("$@");
			set --;
			break;
			;;
		(-f|--file)
			opt_file=1;
			arg_file=$1;
			shift;
			;;
		(-n)
			opt_n=1;
			arg_n=$1;
			[[ "$arg_n" =~ ^[0-9]+$ ]] || {
				1>&2 echo "The value provided to -n must be numeric and positive.";
				exit 1;
			};
			shift;
		    ;;
		(-l)
			opt_l=1;
			;;
		(-t)
			opt_t=1;
			;;
		(-p)
			opt_p=1;
			;;
		(-i)
			opt_i=1;
			;;
		(--fake-su)
			opt_fake_su=1;
			;;
		(--make-command-fail)
			make_command_fail_ids+=("$1");
			shift;
			;;
		(*)
			trailing_args+=("$arg");
			;;
	esac
done;
set -- "${trailing_args[@]}" "$@";
unset trailing_args;
unset arg;


testable() {
	local command_id=$1;
	shift;
    local id;
	for id in "${make_command_fail_ids[@]}"; do
		if [ "$id" == "$command_id" ]; then
			return 1;
		fi;
	done;
	"$@";
}





dump_bin() {
	echo %binary_object;
	# TODO: i probably have to send useless chars and read them back
	# because base64 doesn't seem to handle an actual empty stream.
	base64;
	echo %end;
}
read_line() {
	local IFS="";
	local line;
	read -r line;
	printf %s "$line";
}
read_line_ln() {
	printf '%s\n' "$(read_line)";
}
read_bin() {
	local first_line=$(read_line);
	[ "$first_line" == %binary_object ] || return 1;
	{
		while IFS="" read -r line || [ -n "$line" ]; do
			[ "$line" == %end ] && break;
			printf %s "$line";
		done;
	} | base64 --decode;
}


print_kernel() {
	cat <<"KERNEL";
#!/bin/bash

# The shebang line is for shellcheck

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd);
KERNEL_PATH=$SCRIPT_DIR/${0##*/};

# stdout for communication.  stderr for accidental garbage and trying
# to raise a sigpipe.  stdout is moved to 3 to avoid accidental
# garbage from breaking the protocol.
exec 3>&1 1>&2;

KERNEL

	declare -f dump_bin;
	declare -f read_line;
	declare -f read_line_ln;
	declare -f read_bin;
	declare -f print_kernel;
	declare -f testable;

	cat <<"KERNEL";


echocom() {
	echo "$@" 1>&3;
}

echocom @kernel_start;

send_to_stdout() {
	echocom @@print_stdout;
	dump_bin 1>&3;
}
send_to_stderr() {
	echocom @@print_stderr;
	dump_bin 1>&3;
}

echoout() {
	echo "$@" | send_to_stdout;
}
printfout() {
	printf "$@" | send_to_stdout;
}

echoerr() {
	echo "$@" | send_to_stderr;
}
printferr() {
	printf "$@" | send_to_stderr;
}


# calling panic from inside a subshell will not cause rrssh to stop automatically!
panic() {
	printferr 'PANIC: %s PANIC\n' "$@";
	echocom @panic;
	exit 1;
}

error() {
	printferr 'ERROR: %s ERROR\n' "$@";
}

debug() {
	true || return 0;
	printferr 'DEBUG: %s DEBUG\n' "$@";
}




# the multiple "operation modes" of the kernel are for scanning or
# other details without having to duplicate code.

# The calling protocol of the kernel never requires the whole user
# script to be provided by arguments because it may be
# "dangerously" long (i dont know whether there is a platform with an
# argument limit) or it may contain credentials (must not show up in
# ps aux).

# The user script, files and directories to transmit, most information
# and other "object" types must be provided at the end of the kernel
# script.  Some basic information like the "operation mode" is
# provided via arguments, though.  The line "###;;;" indicates the end
# of the kernel and the beginning of the objects.  First we put all
# small-ish object, which is anything other than files and folders,
# then a separator, then we dump files and folders.  This is to avoid
# the need to skip large files/folders and thus speed up a little bit.



rrssh_id=""; # unique id for the whole runtime
rrssh_fork_depth=0;
rrssh_host_depth=0;



# operation mode
op_mode=""; # enum of: run scan

# are we the first kernel?  therefore we dont have a parent scope.
is_root_kernel=0;

# are we suposed to run only one command chain?
is_one_command_chain_limit=0;




while (($#)); do
	arg=$1;
	shift;
	case "$arg" in
		(--mode)
			op_mode=$1;
			shift;
			;;
		(--root)
			is_root_kernel=1;
			;;
		(--one-command-chain-limit)
			is_one_command_chain_limit=1;
			;;
	esac;
done;
unset arg;



# if we are not the root kernel, then this is the token that's gonna
# close our scope.
toplevel_scope_closing_token="";


toplevel_args=();
total_toplevel_args_shift_count=0;

make_command_fail_ids=();

opt_p=0;
opt_i=0;
opt_fake_su=0;

shift_toplevel_args() {
	local shift_count=${1:-1};
	set -- "${toplevel_args[@]}";
	shift "$shift_count";
	toplevel_args=("$@");
	((total_toplevel_args_shift_count += shift_count));
}
peek_toplevel_args() {
	printf %s "${toplevel_args[0]}";
}
any_toplevel_args_remaining() {
	((${#toplevel_args[@]} > 0));
}

skip_kernel() {
	local line;
	while IFS="" read -r line || [ -n "$line" ]; do
		[ "$line" == "###;;;" ] && break;
	done;
}
load_eof_values() {
	local object_type;
	{
		skip_kernel;
		while IFS="" read -r object_type || [ -n "$object_type" ]; do
			case "$object_type" in
				(@end_of_header)
					break;
					;;
				(@@toplevel_arg)
					toplevel_args+=("$(read_bin)");
					;;
				(@@toplevel_scope_closing_token)
					toplevel_scope_closing_token=$(read_bin);
					;;
				(@@rrssh_id)
					rrssh_id=$(read_bin);
					;;
				(@@rrssh_fork_depth)
					rrssh_fork_depth=$(read_bin);
					;;
				(@@rrssh_host_depth)
					rrssh_host_depth=$(read_bin);
					;;
				(@opt_p)
					opt_p=1;
					;;
				(@opt_i)
					opt_i=1;
					;;
				(@fake_su)
					opt_fake_su=1;
					;;
				(@@make_command_fail_id)
					make_command_fail_ids+=("$(read_bin)");
					;;
				(*)
					panic "Unknown object in kernel dump: '$object_type'.";
					;;
			esac;
		done;
	} < "$KERNEL_PATH";
}




