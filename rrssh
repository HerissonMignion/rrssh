					;;
				(*)
					panic "Unknown object in kernel dump: '$object_type'.";
					;;
			esac;
		done;
		load_extra_messages;
		# if we are a recycled kernel, then the rest was already validated
		if ((opt_recycled)); then
			eof_encountered=1;
			return 0;
		fi;
		while IFS="" read -r object_type || [ -n "$object_type" ]; do
			case "$object_type" in
				(@panic)
					panic "The previous kernel wanted to panic during duplication.";
					;;
				(@@print_stdout)
					echocom @@print_stdout;
					read_bin_pipe_dump_bin 1>&3;
					;;
				(@@print_stderr)
					echocom @@print_stderr;
					read_bin_pipe_dump_bin 1>&3;
					;;
				(@eof)
					eof_encountered=1;
					break;
					;;
				(@@@@file|@@@@dir)
					read_bin_pipe_dump_bin > /dev/null;
					read_bin_pipe_dump_bin > /dev/null;
					read_bin_pipe_dump_bin > /dev/null;
