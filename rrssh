	) 0< "$rootkernel_stdout" 7<&-;
	exec 6>&- 7<&-;
	rm -f "$temp_kernel_path";
	rm -f "$rootkernel_stdin";
	rm -f "$rootkernel_stdout";

	local exitcode_received=0;
	local exitcode=0;
	local panic_received=0;
	local bliss_received=0;
	while IFS="" read -r line || [ -n "$line" ]; do
		case "$line" in
			(@@exitcode)
				exitcode_received=1;
				exitcode=$(read_bin);
				# read_line;
				;;
			(@bliss)
				bliss_received=1;
				;;
			(@panic)
				panic_received=1;
				;;
		esac;
	done < "$temp_com_file";
	rm -f "$temp_com_file";

	if ((panic_received)); then
		if ((exitcode_received)); then
			return "$exitcode";
		else
			return 1;
		fi;
	fi;

	if [ "$mode" == kernel-inner-function ] && ((exitcode_received)); then
		return "$exitcode";
	fi;

	if ! ((bliss_received)); then
		1>&2 echo "PROBLEM: The root subkernel did not end blissfully";
		return 1;
	fi;
}

