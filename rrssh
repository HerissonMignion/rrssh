	if ((is_local)); then
		case "$header" in
			(@@@@file)
				cat -- "$local_source_path" > "$temp_holder";
				;;
			(@@@@dir)
				(cd -- "$local_source_path" && tar -c -f - .) > "$temp_holder";
				;;
			(*)
				rm -f "$temp_holder";
				pipeline_panic "Unknown object '$header'.";
				;;
		esac;
