		fi;
	done;

	if ! ((is_root_kernel)); then
		# send to parent only if parent needs it.
		if is_item_in_list "$dest_dropdir" "${parents_dropdirs[@]}"; then
			echo "$header";
			dump_bin <<<"$dest_dropdir";
			dump_bin <<<"$dest_name";
			dump_bin < "$temp_holder";
		fi;
	fi;

	rm -f "$temp_holder";

}

