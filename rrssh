	load_eof_values;

	main_execution_loop;

	if ! ((is_root_kernel)); then
		echocom @@total_toplevel_shift;
		dump_bin <<<"$total_toplevel_args_shift_count" 1>&3;
	fi;
	echocom @bliss;
}

main;
exit "$?";

