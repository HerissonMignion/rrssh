}





dump_bin() {
	echo %binary_object;
	# TODO: i probably have to send useless chars and read them back
	# because base64 doesn't seem to handle an actual empty stream.
	base64;
	echo %end;
}
read_line() {
	local IFS="";
	local line;
	read -r line;
	printf %s "$line";
}
read_line_ln() {
	printf '%s\n' "$(read_line)";
}
read_bin() {
	local first_line=$(read_line);
	[ "$first_line" == %binary_object ] || return 1;
	{
		while IFS="" read -r line || [ -n "$line" ]; do
			[ "$line" == %end ] && break;
			printf %s "$line";
		done;
	} | base64 --decode;
}


print_kernel() {
	cat <<"KERNEL";
#!/bin/bash

# The shebang line is for shellcheck

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd);
KERNEL_PATH=$SCRIPT_DIR/${0##*/};

# stdout for communication.  stderr for accidental garbage and trying
# to raise a sigpipe.  stdout is moved to 3 to avoid accidental
# garbage from breaking the protocol.
exec 3>&1 1>&2;

KERNEL

	declare -f dump_bin;
	declare -f read_line;
	declare -f read_line_ln;
	declare -f read_bin;
	declare -f print_kernel;

	cat <<"KERNEL";


echocom() {
	echo "$@" 1>&3;
}

send_to_stdout() {
	echocom @@print_stdout;
	dump_bin 1>&3;
}
send_to_stderr() {
	echocom @@print_stderr;
	dump_bin 1>&3;
}

echoout() {
	echo "$@" | send_to_stdout;
}
printfout() {
	printf "$@" | send_to_stdout;
}

echoerr() {
	echo "$@" | send_to_stderr;
}
printferr() {
	printf "$@" | send_to_stderr;
}


# do not call panic from inside a subshell
panic() {
	printferr 'PANIC: %s PANIC\n' "$@";
	echocom @panic;
	exit 1;
}

error() {
	printferr 'ERROR: %s ERROR\n' "$@";
}

debug() {
	true || return 0;
	printferr 'DEBUG: %s DEBUG\n' "$@";
}




# the multiple "operation modes" of the kernel are for scanning or
# other details without having to duplicate code.

# The calling protocol of the kernel never requires the whole user
# script to be provided by arguments because it may be
# "dangerously" long (i dont know whether there is a platform with an
# argument limit) or it may contain credentials (must not show up in
# ps aux).

# The user script, files and directories to transmit, most information
# and other "object" types must be provided at the end of the kernel
# script.  Some basic information like the "operation mode" is
# provided via arguments, though.  The line "###;;;" indicates the end
# of the kernel and the beginning of the objects.  First we put all
# small-ish object, which is anything other than files and folders,
# then a separator, then we dump files and folders.  This is to avoid
# the need to skip large files/folders and thus speed up a little bit.



rrssh_id=""; # unique id for the whole runtime
rrssh_fork_depth=0;
rrssh_host_depth=0;



# operation mode
op_mode=""; # enum of: run scan

# are we the first kernel?  therefore we dont have a parent scope.
is_root_kernel=0;

# are we suposed to run only one command chain?
is_one_command_chain_limit=0;




while (($#)); do
	arg=$1;
	shift;
	case "$arg" in
		(--mode)
			op_mode=$1;
			shift;
			;;
		(--root)
			is_root_kernel=1;
			;;
		(--one-command-chain-limit)
			is_one_command_chain_limit=1;
			;;
	esac;
done;
unset arg;



# if we are not the root kernel, then this is the token that's gonna
# close our scope.
toplevel_scope_closing_token="";


toplevel_args=();
total_toplevel_args_shift_count=0;

opt_p=0;
opt_fake_su=0;

shift_toplevel_args() {
	local shift_count=${1:-1};
	set -- "${toplevel_args[@]}";
	shift "$shift_count";
	toplevel_args=("$@");
	((total_toplevel_args_shift_count += shift_count));
}
peek_toplevel_args() {
	printf %s "${toplevel_args[0]}";
}
any_toplevel_args_remaining() {
	((${#toplevel_args[@]} > 0));
}

skip_kernel() {
	local line;
	while IFS="" read -r line || [ -n "$line" ]; do
		[ "$line" == "###;;;" ] && break;
	done;
}
load_eof_values() {
	local object_type;
	{
		skip_kernel;
		while IFS="" read -r object_type || [ -n "$object_type" ]; do
			case "$object_type" in
				(@end_of_header)
					break;
					;;
				(@@toplevel_arg)
					toplevel_args+=("$(read_bin)");
					;;
				(@@toplevel_scope_closing_token)
					toplevel_scope_closing_token=$(read_bin);
					;;
				(@@rrssh_id)
					rrssh_id=$(read_bin);
					;;
				(@@rrssh_fork_depth)
					rrssh_fork_depth=$(read_bin);
					;;
				(@@rrssh_host_depth)
					rrssh_host_depth=$(read_bin);
					;;
				(@opt_p)
					opt_p=1;
					;;
				(@fake_su)
					opt_fake_su=1;
					;;
				(*)
					panic "Unknown object in kernel dump: '$object_type'.";
					;;
			esac;
		done;
	} < "$KERNEL_PATH";
}







begin_basic_fork() {
	print_kernel;
	echo;
	echo '###;;;';

	local token;
	for token in "${toplevel_args[@]}"; do
		echo @@toplevel_arg;
		dump_bin <<<"$token";
	done;

	((opt_p)) && echo @opt_p;
	((opt_fake_su)) && echo @fake_su;

	echo @@rrssh_id;
	dump_bin <<<"$rrssh_id";
	echo @@rrssh_fork_depth;
	dump_bin <<<$((rrssh_fork_depth + 1));

}

generic_message_handler() {
	# we cannot handle panic because we will always be inside a
	# subshell.  therefore we must forward the panic, which is also
	# our own panic mecanism for unknown message type.

	# the number of @ in general is the number of argments plus one,
	# so that a function like this one can yield back messages that it
	# doesn't support.

	local line;
	while IFS="" read -r line || [ -n "$line" ]; do
		case "$line" in
			(@@print_stdout)
				read_bin | send_to_stdout;
				;;
			(@@print_stderr)
				read_bin | send_to_stderr;
				;;
			(@panic)
				echo @panic;
				;;
			(@bliss)
				echo @bliss;
				;;
			(@@exitcode)
				echocom @@exitcode;
				read_bin | dump_bin 1>&3;
				;;
			(@@*)
				echo "$line";
				read_bin | dump_bin;
				;;
			(@*)
				echo "$line";
				;;
			(*)
				error "generic_message_handler: Unknown message '$line'.  Panic.";
				echo @panic;
				;;
		esac;
	done;
}



# The "contract" with the command commands is as follow: They are
# responsible for shifting and consuming the toplevel_args because
# only they know how much arguments they consume.  They must respect
# the value of op_mode.  They can panic.  They must use their
# exit-code to indicate whether they must be considered successful or
# in error in regards to the operators and or not try.  They must only
# run (but always consume their arguments) if the main loop sets the
# variable indicating to do so.

# the main execution loop sets this when commands must read their
# arguments but skip their execution.  for example when running a
# "command chain".

skip_current_command_execution_flag=0;

current_command_must_run_p() {
	[ "$op_mode" == scan ] && return 1;
	((skip_current_command_execution_flag)) && return 1;
	return 0;
}

command_command() {
	local arg0=$(peek_toplevel_args);
	shift_toplevel_args;

	local arg1=$(peek_toplevel_args);
	local string_command="";
	local is_string=1;
	local argv=();
	local end_token="";

	if [ "$arg0" == --- ]; then
		is_string=0;
		end_token="---";
	else
		shift_toplevel_args;
		if [ "$arg1" == "[" ]; then
			is_string=0;
			end_token="]";
		else
			string_command=$arg1;
		fi;
	fi;
	
	local end_token_reached=0;
	if ! ((is_string)); then
		while any_toplevel_args_remaining; do
			if [ "$(peek_toplevel_args)" == "$end_token" ]; then
				end_token_reached=1;
				shift_toplevel_args;
				break;
			fi;
			argv+=("$(peek_toplevel_args)");
			shift_toplevel_args;
		done;

		((end_token_reached)) || {
			panic "The command 'command' must end with the corresponding ending token: '$end_token'.";
		};
	fi;

	current_command_must_run_p || return 0;

	local rc=0;
	if ((is_string)); then
		bash -c "$string_command" 0< /dev/null 3>&- |& send_to_stdout;
		rc=${PIPESTATUS[0]};
	else
		(
			"${argv[@]}";
			exit "$?";
		) 0< /dev/null 3>&- |& send_to_stdout;
		rc=${PIPESTATUS[0]};
	fi;
	wait;

	return "$rc";
}


command_fork() {
	local command_name=$(peek_toplevel_args);
	shift_toplevel_args;

	# TODO: if forking locally, then dont reprint all files, put a
	# reference to the first kernel on the current host.

	local is_host_command=0;
	local is_su_command=0;
	local is_scope_command=0;
	local is_sudo_prefix=0;

	case "$command_name" in
		(host)
			is_host_command=1;
			;;
		(sudo-host)
			is_host_command=1;
			is_sudo_prefix=1;
			;;
		(su)
			is_su_command=1;
			;;
		(sudo-su)
			is_su_command=1;
			is_sudo_prefix=1;
			;;
		("[")
			is_scope_command=1;
			;;
	esac;

	local arg_destination; # host commands
	local arg_username; # su commands
	if ! ((is_scope_command)); then
		arg_destination=$(peek_toplevel_args);
		arg_username=$(peek_toplevel_args);
		shift_toplevel_args;
		if ! [ "$(peek_toplevel_args)" == "[" ]; then
			panic "The '$command_name' command must begin with an opening '['";
		fi;
	    shift_toplevel_args;
	fi;

	# at this point, the opening square bracket is consumed, the next
	# toplevel arg is the first token inside the scope.  the closing
	# square bracket will come later and be consumed by the sub
	# kernel.

	# pre-execution analysis
	local total_scope_args_shift=0;
	local total_scope_args_shift_provided=0;
	local sub_analyser_bliss=0;


	local sub_analyser_kernel_path=$(mktemp);
	local analysis_output=$(mktemp);
	(
		begin_basic_fork;

		echo @@toplevel_scope_closing_token;
		dump_bin <<<"]";

		echo @@rrssh_host_depth;
		dump_bin <<<$((rrssh_host_depth + 1));

		echo @end_of_header;
	) > "$sub_analyser_kernel_path";
	bash "$sub_analyser_kernel_path" -- --mode scan | generic_message_handler > "$analysis_output";
	rm -f "$sub_analyser_kernel_path";
	local line;
	while IFS="" read -r line || [ -n "$line" ]; do
		case "$line" in
			(@@total_toplevel_shift)
				total_scope_args_shift_provided=1;
				total_scope_args_shift=$(read_bin);
				;;
			(@bliss)
				sub_analyser_bliss=1;
				break;
				;;
			(@panic)
				rm -f "$analysis_output";
				panic "Sub kernel panicked during analysis.";
				;;
			(*)
				rm -f "$analysis_output";
				panic "Unknown message in scope analysis: '$line'.";
				;;
		esac;
	done < "$analysis_output";
	rm -f "$analysis_output";
	((sub_analyser_bliss)) ||
		panic "Sub scope analyser did not end blissfully.";

	current_command_must_run_p || {
	    shift_toplevel_args "$total_scope_args_shift";
		return 0;
	};



	local temp_com_file=$(mktemp);
	(
		begin_basic_fork;



		echo @@toplevel_scope_closing_token;
		dump_bin <<<"]";

		echo @@rrssh_host_depth;
		dump_bin <<<$((rrssh_host_depth + 1));

		echo @end_of_header;

		# TODO: append files and folders only if we are a host
		# command.

	) | (

		print_landing_script() {

			# the landing script should always exit 0 if it
			# successfully runs the kernel, so that we know from the
			# exit code whether the ssh/su command or the landing
			# failed.

			local call_args=("$@");
			cat <<LANDING_SCRIPT;
echo @landing_start;

call_args=($(printf "%q " "${call_args[@]}"));
LANDING_SCRIPT

			declare -f dump_bin;

			cat <<"LANDING_SCRIPT";

send_to_stderr() {
	echo @@print_stderr;
	dump_bin;
}
printferr() {
	printf "$@" | send_to_stderr;
}
error() {
	printferr "ERROR: %s ERROR\n" "$@";
}
debug() {
	printferr "DEBUG: %s DEBUG\n" "$@";
}


kernel_file_path=$(mktemp) || {
	exit 1;
};

tee "$kernel_file_path" &> /dev/null || {
	rm -f "$kernel_file_path";
	exit 1;
};

bash "$kernel_file_path" -- "${call_args[@]}";
rm -f "$kernel_file_path";
exit 0;

LANDING_SCRIPT

		}

		cmd=();
		if ((is_sudo_prefix)); then
			cmd+=(sudo);
		fi;
		if ((is_host_command)); then
			cmd+=(ssh -o ConnectTimeout=10 -- "$arg_destination");
		elif ((is_su_command)); then
			if ! ((opt_fake_su)); then
				cmd+=(su --login -- "$arg_username" -c);
			else
				cmd+=(bash -c);
			fi;
		elif ((is_scope_command)); then
			cmd+=(bash -c);
		fi;

		"${cmd[@]}" "bash -c $(printf %q "$(print_landing_script --mode run)")";
		fork_command_rc=$?;

		echo @@fork_command_rc;
		dump_bin <<<"$fork_command_rc";

	) | (

		generic_message_handler;

	) | (

		# we handle file/folder transfers and other things here so
		# that it happens simultaneously accross all hosts, and thus
		# faster than one host at a time.  however we are in a
		# subshell.  temp_com_file is for information that must be
		# kept outside the subshell.

		while IFS="" read -r line || [ -n "$line" ]; do
			case "$line" in
				(@panic)
					echo @panic;
					;;
				(@bliss)
					echo @bliss;
					# break; # we need to receive fork_command_rc
					;;
				(@@*)
					echo "$line";
					read_bin | dump_bin;
					;;
				(@*)
					echo "$line";
					;;
				(*)
					error "Unknown message received from sub kernel: '$line'. PANIC";
					echo @panic;
					break;
					;;
			esac;
		done;

	) > "$temp_com_file";

	local bliss_received=0;
	local must_panic=0;
	local execution_total_args_shift=0;
	local scope_exitcode_received=0;
	local scope_exitcode=0;
	local fork_command_rc_received=0;
	local fork_command_rc=0;
	local landing_start_received=0;
	while IFS="" read -r line || [ -n "$line" ]; do
		case "$line" in
			(@panic)
				must_panic=1;
				break;
				;;
			(@bliss)
				bliss_received=1;
				# break; # we need to receive fork_command_rc
				;;
			(@@total_toplevel_shift)
				execution_total_args_shift=$(read_bin);
				;;
			(@@scope_exitcode)
				scope_exitcode_received=1;
				scope_exitcode=$(read_bin);
				;;
			(@@fork_command_rc)
				fork_command_rc_received=1;
				fork_command_rc=$(read_bin);
				;;
			(@landing_start)
				landing_start_received=1;
				;;
			(*)
				error "Unknown message received from sub kernel parsing code: '$line'.";
				must_panic=1;
				break;
				;;
		esac;
	done < "$temp_com_file";
	rm -f "$temp_com_file";

	if ((must_panic)); then
		panic "Triggering a panic.";
	fi;

	if ((fork_command_rc_received)) && ! ((fork_command_rc == 0)); then

		# whether we received @landing_start is the difference between
		# a failing ssh/su VS the landing script that exited non-0
		# voluntarily.

		if ((landing_start_received)); then
			panic "The ssh or su command seems to succeed, but the sub-kernel could not be started.";
		else
			panic "The ssh or su command seems to fail." \
				"Is an ssh key missing?" \
				"Is ssh, su, or sudo prompting for a password?" \
				"Is the destination resolving and reachable?" \
				"Is there any spelling misatke?";
		fi;
	fi;

	[ "$execution_total_args_shift" == "$total_scope_args_shift" ] || {

		# if the sub scope did not end because of a non-0 command, it
		# is normal that execution did not consume as many arguments
		# as pre-execution analysis.

		if ((scope_exitcode == 0)); then
			panic "The amount of token consumed during scope analysis is not equal as when executed.  scan: $total_scope_args_shift. execution: $execution_total_args_shift";
		fi;
	};
	shift_toplevel_args "$total_scope_args_shift";

	if ! ((bliss_received)); then
		panic "Sub kernel at remote host did not end blissfully.";
	fi;

	if ((scope_exitcode_received)); then
		return "$scope_exitcode";
	fi;

}


main_execution_loop() {

	local current_toplevel_command;
	local current_command_rc=0;
	local current_command_reverse_rc=0;
	local current_chain_rc=0;
	local is_first_command_of_chain=1;
	local current_chain_has_try_prefix=0;
	local operator_used=0;

	skip_current_command_execution_flag=0;
	while any_toplevel_args_remaining; do
		current_command_rc=0;
		current_command_reverse_rc=0;
		operator_used=0;

		if ((is_first_command_of_chain)); then
			# TODO: check whether we are not root kernel.
			if [ "$(peek_toplevel_args)" == "$toplevel_scope_closing_token" ]; then
				shift_toplevel_args;
				break;
			fi;
		fi;

		if ((is_first_command_of_chain)); then
			if [ "$(peek_toplevel_args)" == try ]; then
				current_chain_has_try_prefix=1;
				shift_toplevel_args;
			fi;
		fi;

		if any_toplevel_args_remaining && [ "$(peek_toplevel_args)" == not ]; then
			current_command_reverse_rc=1;
			shift_toplevel_args;
		fi;

		if ! any_toplevel_args_remaining; then
			panic "An rrssh command must be provided after a prefix.";
		fi;
		current_toplevel_command=$(peek_toplevel_args);

		case "$current_toplevel_command" in
			(command|---)
				command_command;
				current_command_rc=$?;
				;;
			(host|sudo-host|su|sudo-su|"[")
				command_fork;
				current_command_rc=$?;
				;;
			(true)
				shift_toplevel_args;
				current_command_rc=0;
				;;
			(false)
				shift_toplevel_args;
				current_command_rc=1;
				;;
			(debug)
				shift_toplevel_args;
				if current_command_must_run_p; then
					echoout "ASDF";
				fi;
				;;
			(*)
				# TODO: check whether this is the token that closes
				# our current scope.

				echocom @@exitcode;
				dump_bin <<<"1" 1>&3;
				panic "Invalid rrssh command: '$current_toplevel_command'.";
				;;
		esac;
		is_first_command_of_chain=0;
		((current_command_reverse_rc)) && ((current_command_rc ^= 1));

		# if the command had to run, its return code is now the
		# current return code of the command chain.
		if current_command_must_run_p; then
			current_chain_rc=$current_command_rc;
		fi;

		if any_toplevel_args_remaining; then
			case "$(peek_toplevel_args)" in
				(and)
					operator_used=1;
					skip_current_command_execution_flag=$current_chain_rc;
					;;
				(or)
					operator_used=1;
					skip_current_command_execution_flag=$((current_chain_rc ^ 1));
					;;
			esac;
			if ((operator_used)); then
				shift_toplevel_args;
				if ! any_toplevel_args_remaining; then
					panic "An rrssh command must be provided after an infix operator.";
				fi;
				continue;
			fi;
		fi;

		# when execution reaches here, we have completed a complete "command chain"
		if ! ((current_chain_has_try_prefix)) && ! ((current_chain_rc == 0)); then
			if ((opt_p)) || ((is_root_kernel)); then
				echocom @@exitcode;
				dump_bin <<<"$current_chain_rc" 1>&3;
				# TODO: add command chain and line number to error message
				panic "The command chain exited non-0.";
			else
				echocom @@scope_exitcode;
				dump_bin <<<"$current_chain_rc" 1>&3;
				break;
			fi;
		fi;

		# now we reset flags for the next "command chain".
		is_first_command_of_chain=1;
		skip_current_command_execution_flag=0;
		current_chain_has_try_prefix=0;
		current_chain_rc=0;

	done;

}


main() {
	load_eof_values;

	main_execution_loop;

	if ! ((is_root_kernel)); then
		echocom @@total_toplevel_shift;
		dump_bin <<<"$total_toplevel_args_shift_count" 1>&3;
	fi;
	echocom @bliss;
}

main;
exit "$?";

