					rm -f "$temp_holder";
					pipeline_panic "Could not cd to dropdir '${localhost_dropdirs_paths[i]}'.";
				};

				case "$header" in
					(@@@@file)
						tee -- "$dest_name" < "$temp_holder" &> /dev/null || {
							rm -f "$temp_holder";
							pipeline_panic "Could not write into file '$dest_name'.";
						};
						;;
					(@@@@dir)
						mkdir -- "$dest_name" || {
							rm -f "$temp_holder";
							pipeline_panic "Could not create directory '$dest_name'.";
						};
						cd -- "$dest_name" || {
							rm -f "$temp_holder";
							pipeline_panic "Could not change directory into '$dest_name'.";
						};
