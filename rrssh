		bash "$temp_kernel_path" -- --mode "$mode" --root --stdin 2> /dev/null;
	) 0< "$rootkernel_stdin" 1> "$rootkernel_stdout" &
	exec 6> "$rootkernel_stdin" 7< "$rootkernel_stdout";
	
	(
		# TODO: improve traps.

		must_panic=0;

		first_loop=1;
		restart_loop=0;
		trap_ran=0;

		trap_cmd() {
			trap_ran=1;
			local i;
			# ensure that we send @panic even if we desync with the
			# messages and dont catch any future @epoll_panic.
			for ((i = 0; i < 10; i++)); do
				echo @panic;
			done 1>&6;
			must_panic=1;
			1>&2 echo;
			1>&2 echo "Triggering panic at earliest opportunity.";
			1>&2 echo;
		}

