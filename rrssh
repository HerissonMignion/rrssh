			);
		fi;
	elif ! ((landing_start_received)); then
		landing_failed=1;
		landing_msgs+=(
			"The ssh or su command seems to fail."
			"Is an ssh key missing?"
			"Is ssh, su, or sudo prompting for a password?"
			"Is the destination resolving and reachable?"
			"Is there any spelling misatke?"
		);
	elif ! ((kernel_start_received)); then
		landing_failed=1;
		landing_msgs+=(
			"The ssh or su command succeeded, but the kernel failed to start."
		);
	fi;

	if ((landing_failed)); then
		if ! ((opt_i)); then
			panic "${landing_msgs[@]}";
		else

			# MAYBE TODO: maybe we should still panic if we are a
			# simple scope and not a host or su command.

			ignore_missing_bliss=1;
			# instead of panicking, we behave like a scope that exited non-0.
			scope_exitcode_received=1;
			scope_exitcode=1;
		fi;
	fi;

	[ "$execution_total_args_shift" == "$total_scope_args_shift" ] || {

		# if the sub scope did not end because of a non-0 command, it
		# is normal that execution did not consume as many arguments
		# as pre-execution analysis.

		if ((scope_exitcode == 0)); then
			panic "The amount of token consumed during scope analysis is not equal as when executed.  scan: $total_scope_args_shift. execution: $execution_total_args_shift. bliss: $bliss_received. ";
		fi;
	};
	shift_toplevel_args "$total_scope_args_shift";

	if ! ((bliss_received)) && ! ((ignore_missing_bliss)); then
		panic "Sub kernel at remote host did not end blissfully.";
	fi;

	if ((scope_exitcode_received)); then
		return "$scope_exitcode";
	fi;

}

