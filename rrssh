# THE script to be executed.
toplevel_commands=();
toplevel_commands_provided=0;

read_toplevel_commands_from_file() {
	local filepath=$1;
	local current_line_number=1;
	local output_file=$(mktemp);
	local temp_script_path;
	local line;
	local word;
	local parsed_word;
	while IFS="" read -r line || [ -n "$line" ]; do
		temp_script_path=$(mktemp);
		{
			# printf %q ensure that all arguments are only one line
			# when printed.
			cat <<"SCRIPT";
				print_args() {
					(($# > 0)) && printf %q\\n "$@";
					exit 0;
				}
SCRIPT
			printf %s\\n "print_args $line";
		} > "$temp_script_path";

		bash -s -n < "$temp_script_path" &> /dev/null || {
			rm -f "$temp_script_path";
			1>&2 echo "Error in file '$filepath' on line $current_line_number.";
			exit 1;
		};
		bash -s < "$temp_script_path" > "$output_file";
		rm -f "$temp_script_path";

		while IFS="" read -r word || [ -n "$word" ]; do
			parsed_word="$(
				# subshell for safety.
				eval "output=$word";
				printf %s "$output";
			)";
			toplevel_commands+=("$parsed_word");
		done < "$output_file";

		((current_line_number++));
	done < "$filepath";
	rm -f "$output_file";
	
	toplevel_commands_provided=1;
}
read_toplevel_commands_from_arguments() {
	toplevel_commands=("${arg_script[@]}");
	toplevel_commands_provided=1;
}




command_check() {
	((toplevel_commands_provided)) || {
		1>&2 echo "You must provide a rrssh script.";
		return 1;
	};
	return 0;
}

command_run() {
	command_check || return 1;

	local temp_kernel_path=$(mktemp);
	(
		print_kernel;
		echo;
		echo "###;;;";
		
		for toplevel_arg in "${toplevel_commands[@]}"; do
			echo @@toplevel_arg;
			dump_bin <<<"$toplevel_arg";
		done;

		((opt_p)) && echo @opt_p;
		((opt_fake_su)) && echo @fake_su;

		echo @@rrssh_id;
		tr -dc 0123456789abcdefghijklmnopqrstuvwxyz < /dev/urandom | head -c 10 | dump_bin;
		echo @@rrssh_fork_depth;
		dump_bin <<<"0";
		echo @@rrssh_host_depth;
		dump_bin <<<"0";
		
		echo @end_of_header;
	) > "$temp_kernel_path";
	local temp_com_file=$(mktemp);
	bash "$temp_kernel_path" -- --mode run --root 2> /dev/null | (
		while IFS="" read -r line || [ -n "$line" ]; do
			case "$line" in
				(@@print_stdout)
					read_bin;
					;;
				(@@print_stderr)
					read_bin 1>&2;
					;;
				(@bliss)
					echo @bliss >> "$temp_com_file";
					break;
					;;
				(@@exitcode)
					echo @@exitcode >> "$temp_com_file";
					read_bin >> "$temp_com_file";
					;;
				(@panic)
					echo @panic >> "$temp_com_file";
					;;
				(*)
					1>&2 echo "Unknown object in kernel output: $line";
					# MAYBE TODO: throw a real error?
					;;
			esac;
		done;
	);
	rm -f "$temp_kernel_path";

	local exitcode_received=0;
	local exitcode=0;
	local panic_received=0;
	local bliss_received=0;
	while IFS="" read -r line || [ -n "$line" ]; do
		case "$line" in
			(@@exitcode)
				exitcode_received=1;
				exitcode=$(read_bin);
				# read_line;
				;;
			(@bliss)
				bliss_received=1;
				break;
				;;
			(@panic)
				panic_received=1;
				;;
		esac;
	done < "$temp_com_file";
	rm -f "$temp_com_file";

	if ((panic_received)); then
		if ((exitcode_received)); then
			return "$exitcode";
		else
			return 1;
		fi;
	fi;

	if ! ((bliss_received)); then
		1>&2 echo "PROBLEM: The root subkernel did not end blissfully";
		return 1;
	fi;
}

main() {
	if (($# == 0)); then
		echo "You must provide a command.";
		return 1;
	fi;
	local cmd=$1;

	if ((opt_file)); then
		local temp_script_file_path=$(mktemp);
		if [ "$arg_file" == "-" ]; then
		    cat > "$temp_script_file_path";
		else
			cat -- "$arg_file" > "$temp_script_file_path";
		fi;
		read_toplevel_commands_from_file "$temp_script_file_path";
		rm -f "$temp_script_file_path";
	elif ((opt_script_provided)); then
		read_toplevel_commands_from_arguments;
	fi

	shift;
	case "$cmd" in
		(print-kernel)
			print_kernel;
			;;
		(run)
			command_run;
			;;
		(print)
			((toplevel_commands_provided)) || {
				1>&2 echo "You need to provide a script";
				return 1;
			};
			if ((opt_t)); then
				echo "${#toplevel_commands[@]}";
			else
				local printf_arg=$(((opt_l)) && echo '%s\n' || echo '%q\n');
				if ((opt_n)); then
					((arg_n < ${#toplevel_commands[@]})) || {
						1>&2 echo "The value provided to -n is larger than the number of tokens.";
						return 1;
					};
					printf "$printf_arg" "${toplevel_commands[$arg_n]}";
				else
					printf "$printf_arg" "${toplevel_commands[@]}";
				fi;
			fi;
			;;
		(*)
			1>&2 echo "Unknown command '$cmd'.";
			return 1;
			;;
	esac;
}


main "$@";
exit "$?";

