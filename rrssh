read_toplevel_commands_from_file() {
	local filepath=$1;
	local current_line_number=1;
	local output_file=$(mktemp);
	local temp_script_path;
	local line;
	local word;
	local parsed_word;
	while IFS="" read -r line || [ -n "$line" ]; do
		temp_script_path=$(mktemp);
		{
			# printf %q ensure that all arguments are only one line
			# when printed.
			cat <<"SCRIPT";
				print_args() {
					(($# > 0)) && printf %q\\n "$@";
					exit 0;
				}
SCRIPT
			printf %s\\n "print_args $line";
		} > "$temp_script_path";

		bash -s -n < "$temp_script_path" &> /dev/null || {
			rm -f "$temp_script_path";
			1>&2 echo "Error in file '$filepath' on line $current_line_number.";
			exit 1;
		};
		bash -s < "$temp_script_path" > "$output_file";
		rm -f "$temp_script_path";

		while IFS="" read -r word || [ -n "$word" ]; do
			parsed_word="$(
				# subshell for safety.
				eval "output=$word";
				printf %s "$output";
			)";
			toplevel_commands+=("$parsed_word");
		done < "$output_file";

		((current_line_number++));
	done < "$filepath";
	rm -f "$output_file";
	
	toplevel_commands_provided=1;
}
read_toplevel_commands_from_arguments() {
	toplevel_commands=("${arg_script[@]}");
	toplevel_commands_provided=1;
}



