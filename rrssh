		trap "echo TERM; trap_cmd;" SIGTERM;
		trap "echo KILL; trap_cmd;" SIGKILL;
		trap "echo INT; trap_cmd;" SIGINT;
		trap "echo QUIT; trap_cmd;" SIGQUiT;



		while ((first_loop)) || ((restart_loop)); do
			first_loop=0;
			restart_loop=0;
			while IFS="" read -r line || [ -n "$line" ]; do
				case "$line" in
					(@@print_stdout)
						read_bin;
						;;
					(@@print_stderr)
						read_bin 1>&2;
						;;
					(@bliss)
						if ! ((must_panic)); then
							echo @bliss >> "$temp_com_file";
						else
							echo @panic >> "$temp_com_file";
						fi;
						;;
					(@@exitcode)
						echo @@exitcode >> "$temp_com_file";
						read_bin_pipe_dump_bin 2> /dev/null >> "$temp_com_file";
						;;
					(@panic)
						echo @panic >> "$temp_com_file";
						;;
					(@epoll_panic)
						if ! ((must_panic)); then
							echo @continue 1>&6;
						else
							echo @panic 1>&6;
						fi;
						;;
					(@kernel_start)
